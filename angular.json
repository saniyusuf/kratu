{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "kratu": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/fonts.scss",
              "src/design.css",
              "src/app.css",
              "src/styles.scss"
            ],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "sw": {
              "outputPath": "dist/kratu-sw",
              "fileReplacements": [
                {
                  "replace": "src/app/core/lang/lang.ts",
                  "with": "src/app/core/lang/lang.sw.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "assets/clips.json",
                    "assets/words.json",
                    "assets/media.json",
                    "assets/audio/ha/**",
                    "names_bank_expanded.json",
                    "assets/audio/en/app_*",
                    "assets/audio/en/word_*"
                  ]
                },
                {
                  "glob": "**/*",
                  "input": "langs/sw/public"
                }
              ]
            },
            "yo": {
              "outputPath": "dist/kratu-yo",
              "fileReplacements": [
                {
                  "replace": "src/app/core/lang/lang.ts",
                  "with": "src/app/core/lang/lang.yo.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "assets/clips.json",
                    "assets/words.json",
                    "assets/media.json",
                    "assets/audio/ha/**",
                    "names_bank_expanded.json"
                  ]
                },
                {
                  "glob": "**/*",
                  "input": "langs/yo/public"
                }
              ]
            },
            "ig": {
              "outputPath": "dist/kratu-ig",
              "fileReplacements": [
                {
                  "replace": "src/app/core/lang/lang.ts",
                  "with": "src/app/core/lang/lang.ig.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "assets/clips.json",
                    "assets/words.json",
                    "assets/media.json",
                    "assets/audio/ha/**",
                    "names_bank_expanded.json"
                  ]
                },
                {
                  "glob": "**/*",
                  "input": "langs/ig/public"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "kratu:build:production"
            },
            "development": {
              "buildTarget": "kratu:build:development"
            },
            "sw": {
              "buildTarget": "kratu:build:development,sw"
            },
            "sw-production": {
              "buildTarget": "kratu:build:production,sw"
            },
            "yo": {
              "buildTarget": "kratu:build:development,yo"
            },
            "yo-production": {
              "buildTarget": "kratu:build:production,yo"
            },
            "ig": {
              "buildTarget": "kratu:build:development,ig"
            },
            "ig-production": {
              "buildTarget": "kratu:build:production,ig"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "headers": {
              "Cross-Origin-Opener-Policy": "same-origin",
              "Cross-Origin-Embedder-Policy": "require-corp"
            }
          }
        }
      }
    }
  }
}
