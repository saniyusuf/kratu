{
  "name": "kratu",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content": "node scripts/build-content.mjs",
    "lint:content": "node scripts/lint.mjs",
    "voice": "node scripts/voice.mjs",
    "words": "node scripts/words.mjs",
    "start": "npm run content && ng serve",
    "build": "npm run content && npm run lint:content && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "content:sw": "node scripts/build-content.mjs --lang sw",
    "lint:sw": "node scripts/lint.mjs --lang sw",
    "voice:sw": "node scripts/voice.mjs --lang sw",
    "start:sw": "npm run content:sw && ng serve --configuration sw --port 4201",
    "build:sw": "npm run content:sw && npm run lint:sw && ng build --configuration production,sw",
    "content:yo": "node scripts/build-content.mjs --lang yo",
    "lint:yo": "node scripts/lint.mjs --lang yo",
    "voice:yo": "node scripts/voice.mjs --lang yo",
    "start:yo": "npm run content:yo && ng serve --configuration yo --port 4202",
    "build:yo": "npm run content:yo && npm run lint:yo && ng build --configuration production,yo"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2"
  }
}
