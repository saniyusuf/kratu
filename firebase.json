{
  "hosting": [
    {
      "target": "school",
      "public": "dist/kratu/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cross-Origin-Embedder-Policy",
              "value": "require-corp"
            }
          ]
        },
        {
          "source": "/@(main|chunk|polyfills|styles)-*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(onnx|part0|part1|part2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Content-Type",
              "value": "application/octet-stream"
            }
          ]
        },
        {
          "source": "**/models/ort/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "**/models/**/*.onnx.gz",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            },
            {
              "key": "Content-Type",
              "value": "application/gzip"
            }
          ]
        },
        {
          "source": "**/vosk-model/**/*.gz",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "**/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/@(kratu-id|kratu-id.worker|vosk|ngsw-worker|kratu-sw|safety-worker|worker-basic.min).js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/@(manifest.json|ngsw.json|index.html|manifest.webmanifest|names_bank_expanded.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "predeploy": [
        "node tools/deploy-guard.mjs school"
      ]
    },
    {
      "target": "family",
      "public": "dist/family/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/name",
          "function": {
            "functionId": "familyApi",
            "region": "europe-west1"
          }
        },
        {
          "source": "/api/say",
          "function": {
            "functionId": "familyApi",
            "region": "europe-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cross-Origin-Embedder-Policy",
              "value": "require-corp"
            }
          ]
        },
        {
          "source": "/@(main|chunk|polyfills|styles)-*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(onnx|part0|part1|part2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Content-Type",
              "value": "application/octet-stream"
            }
          ]
        },
        {
          "source": "**/models/ort/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "**/models/**/*.onnx.gz",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            },
            {
              "key": "Content-Type",
              "value": "application/gzip"
            }
          ]
        },
        {
          "source": "**/vosk-model/**/*.gz",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "**/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/@(kratu-id|kratu-id.worker|vosk|ngsw-worker|kratu-sw|safety-worker|worker-basic.min).js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/@(manifest.json|ngsw.json|index.html|manifest.webmanifest|names_bank_expanded.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "predeploy": [
        "node tools/deploy-guard.mjs family"
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "family",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "firebase-debug.log"
      ],
      "predeploy": [
        "node tools/deploy-guard.mjs functions"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
