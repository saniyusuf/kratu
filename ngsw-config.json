{
 "$schema": "./node_modules/@angular/service-worker/config/schema.json",
 "index": "/index.html",
 "assetGroups": [
  {
   "name": "app",
   "installMode": "prefetch",
   "resources": {
    "files": [
     "/favicon.ico",
     "/index.html",
     "/manifest.webmanifest",
     "/*.css",
     "/*.js",
     "/icons/*.png"
    ]
   }
  },
  {
   "name": "engines",
   "installMode": "prefetch",
   "updateMode": "prefetch",
   "resources": {
    "files": [
     "/kratu-id.worker.js",
     "/models/ort/*.mjs",
     "/models/manifest.json",
     "/vosk-model/manifest.json",
     "/names_bank_expanded.json"
    ]
   }
  },
  {
   "name": "media",
   "installMode": "prefetch",
   "updateMode": "prefetch",
   "resources": {
    "files": [
     "/assets/**"
    ]
   }
  }
 ],
 "navigationRequestStrategy": "freshness"
}
